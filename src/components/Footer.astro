---
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand-line"><img src="/images/logo/neofilm-icon.png" alt="" width="32" height="32" />NeoFilm</a>
      <p>Film-inspired color, manual camera tools, and a mobile Darkroom.</p>
      <span>Available for Android and iPhone</span>
    </div>
    <nav aria-label="Product links">
      <strong>Explore</strong>
      <a href="/features/">Features</a>
      <a href="/film-recipes/">Film recipes</a>
      <a href="/darkroom/">Darkroom</a>
      <a href="/gallery/">Gallery</a>
    </nav>
    <nav aria-label="Support and legal links">
      <strong>Support</strong>
      <a href="/support/">Help and FAQ</a>
      <a href="/privacy/">Privacy policy</a>
      <a href="/terms/">Terms of use</a>
      <a href={`mailto:${siteConfig.supportEmail}`}>Contact us</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>{siteConfig.publisher.copyrightText}</span>
    <span>Photos are processed on your device. Purchases are managed by Google Play or Apple.</span>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; padding: 64px 0 32px; background: #08080a; border-top: 1px solid var(--color-seam); }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 56px; padding-bottom: 48px; }
  .brand-line { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 15px; font-size: 1.15rem; font-weight: 800; }
  .brand-line img { border-radius: 7px; }
  .footer-brand p { max-width: 430px; font-size: .95rem; }
  .footer-brand span { display: block; margin-top: 14px; color: var(--color-text-muted); font-size: .8rem; }
  nav { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  nav strong { margin-bottom: 4px; font-size: .82rem; text-transform: uppercase; letter-spacing: .09em; }
  nav a { color: var(--color-text-secondary); font-size: .9rem; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 24px; padding-top: 24px; border-top: 1px solid var(--color-seam); color: var(--color-text-muted); font-size: .75rem; }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; } .footer-brand { grid-column: 1 / -1; } .footer-bottom { flex-direction: column; } }
</style>
