---
import { siteConfig } from '../config/site';
import StoreBadgeButtons from './StoreBadgeButtons.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Top Grid Section -->
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand" aria-label="NeoFilm Home">
          <img
            src="/images/logo/neofilm-icon.png"
            alt=""
            width="32"
            height="32"
            class="footer-brand-icon"
          />
          <span class="footer-brand-title">{siteConfig.name}</span>
        </a>
        <p class="footer-tagline">
          {siteConfig.tagline}
        </p>
        <p class="footer-desc">
          Tactile vintage film camera and mobile darkroom for iPhone and Android.
        </p>
        <div class="footer-badges">
          <StoreBadgeButtons size="normal" />
        </div>
      </div>

      <!-- Col 2: Product -->
      <div class="footer-col">
        <h2 class="footer-heading">Product</h2>
        <ul class="footer-links">
          <li><a href="/features/">Features & Manual Controls</a></li>
          <li><a href="/film-recipes/">Film Profiles & Recipes</a></li>
          <li><a href="/darkroom/">RAW Sensor & Darkroom</a></li>
          <li>
            <a href={siteConfig.stores.ios.url} target="_blank" rel="noopener noreferrer">
              Download for iPhone
            </a>
          </li>
          <li>
            <a href={siteConfig.stores.android.url} target="_blank" rel="noopener noreferrer">
              Get it on Google Play
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Support & Community -->
      <div class="footer-col">
        <h2 class="footer-heading">Support & Help</h2>
        <ul class="footer-links">
          <li><a href="/support/">Help Center & FAQ</a></li>
          <li><a href="/support/#troubleshooting">Permissions & Troubleshooting</a></li>
          <li><a href="/support/#subscriptions">Subscriptions & Restore</a></li>
          <li>
            <a href={`mailto:${siteConfig.supportEmail}`}>
              {siteConfig.supportEmail}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Privacy -->
      <div class="footer-col">
        <h2 class="footer-heading">Legal & Compliance</h2>
        <ul class="footer-links">
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
          <li>
            <span class="footer-privacy-note">100% on-device photo processing. Zero trackers.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider Line -->
    <div class="footer-divider"></div>

    <!-- Bottom Trademarks & Copyright -->
    <div class="footer-bottom">
      <div class="copyright-text">
        <p>{siteConfig.publisher.copyrightText}</p>
      </div>

      <div class="trademarks-text">
        <p>
          Apple, the Apple logo, and iPhone are trademarks of Apple Inc., registered in the U.S. and other countries.
          App Store is a service mark of Apple Inc. Google Play and the Google Play logo are trademarks of Google LLC.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #08080a;
    border-top: 1px solid var(--color-seam);
    padding-top: 64px;
    padding-bottom: 48px;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1.2fr;
    gap: 48px;
    margin-bottom: 56px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 14px;
  }

  .footer-brand-icon {
    border-radius: var(--radius-sm);
  }

  .footer-brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .footer-tagline {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .footer-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 320px;
    margin-bottom: 20px;
  }

  .footer-badges {
    margin-top: 8px;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
    margin-bottom: 18px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-privacy-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    display: block;
    padding-top: 4px;
  }

  .footer-divider {
    height: 1px;
    background-color: var(--color-seam);
    margin-bottom: 32px;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .copyright-text p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .trademarks-text p {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    line-height: 1.6;
    max-width: 900px;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 580px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .brand-col {
      grid-column: span 1;
    }
  }
</style>
