---
import { siteConfig } from '../config/site';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  type?: 'application' | 'mac-application' | 'breadcrumb' | 'faq';
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: FaqItem[];
}

const { type = 'application', breadcrumbs = [], faqItems = [] } = Astro.props;

// 1. MobileApplication Schema
const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: siteConfig.formalName,
  alternateName: siteConfig.name,
  description: siteConfig.description,
  applicationCategory: 'PhotographyApplication',
  operatingSystem: `${siteConfig.stores.android.minTarget}, ${siteConfig.stores.ios.minTarget}`,
  url: siteConfig.url,
  downloadUrl: [
    siteConfig.stores.android.url,
    ...(siteConfig.stores.ios.status === 'available' ? [siteConfig.stores.ios.url] : []),
  ],
  author: {
    '@type': 'Organization',
    name: siteConfig.publisher.name,
    url: siteConfig.url,
  }
};

// 2. macOS SoftwareApplication Schema (NeoFilm Lab)
const macApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NeoFilm Lab',
  alternateName: 'NeoFilm Lab for macOS',
  description:
    'Native macOS photo editor and film-recipe workbench for the NeoFilm ecosystem. Develop camera RAW and high-resolution photos with 39+ film stocks, real-time Metal GPU grading, and QR recipe sync to iPhone and Android.',
  applicationCategory: 'PhotographyApplication',
  operatingSystem: 'macOS 14.0 or later',
  softwareVersion: siteConfig.stores.macLab.version,
  url: `${siteConfig.url}/lab/`,
  image: `${siteConfig.url}/images/og/og-lab.jpg`,
  screenshot: [
    `${siteConfig.url}/images/lab/lab-workbench-hero.webp`,
    `${siteConfig.url}/images/lab/lab-split-compare.webp`,
    `${siteConfig.url}/images/lab/lab-qr-sync.webp`,
  ],
  offers: {
    '@type': 'Offer',
    price: '19.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `${siteConfig.url}/lab/#buy`,
  },
  author: {
    '@type': 'Organization',
    name: siteConfig.publisher.name,
    url: siteConfig.url,
  },
};

// 3. BreadcrumbList Schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.url.startsWith('http') ? crumb.url : new URL(crumb.url, siteConfig.url).href
  }))
} : null;

// 4. FAQPage Schema
const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
} : null;
---

{type === 'application' && (
  <script type="application/ld+json" set:html={JSON.stringify(applicationSchema)} />
)}

{type === 'mac-application' && (
  <script type="application/ld+json" set:html={JSON.stringify(macApplicationSchema)} />
)}

{type === 'breadcrumb' && breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

{type === 'faq' && faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
