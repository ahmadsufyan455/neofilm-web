---
import { siteConfig } from '../config/site';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  type?: 'application' | 'breadcrumb' | 'faq';
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: FaqItem[];
}

const { type = 'application', breadcrumbs = [], faqItems = [] } = Astro.props;

// 1. MobileApplication Schema
const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: siteConfig.formalName,
  alternateName: siteConfig.name,
  description: siteConfig.description,
  applicationCategory: 'PhotographyApplication',
  operatingSystem: 'iOS 17.0 or later, Android 8.0 or later',
  url: siteConfig.url,
  downloadUrl: [
    siteConfig.stores.ios.url,
    siteConfig.stores.android.url
  ],
  author: {
    '@type': 'Organization',
    name: siteConfig.publisher.name,
    url: siteConfig.url,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free download with optional NeoFilm Pro subscription or lifetime purchase'
  }
};

// 2. BreadcrumbList Schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.url.startsWith('http') ? crumb.url : new URL(crumb.url, siteConfig.url).href
  }))
} : null;

// 3. FAQPage Schema
const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
} : null;
---

{type === 'application' && (
  <script type="application/ld+json" set:html={JSON.stringify(applicationSchema)} />
)}

{type === 'breadcrumb' && breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

{type === 'faq' && faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
