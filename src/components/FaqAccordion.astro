---
export interface FaqItem {
  id?: string;
  question: string;
  answer: string;
}

export interface Props {
  items: FaqItem[];
  title?: string;
  subtitle?: string;
}

const { items, title, subtitle } = Astro.props;
---

<div class="faq-accordion-container">
  {title && (
    <div class="faq-header">
      <span class="badge-mono badge-accent">HELP &amp; FAQ</span>
      <h2 class="faq-title">{title}</h2>
      {subtitle && <p class="faq-subtitle">{subtitle}</p>}
    </div>
  )}

  <div class="faq-list">
    {items.map((item, index) => (
      <details class="faq-item" id={item.id || `faq-item-${index + 1}`}>
        <summary class="faq-summary">
          <span class="faq-question">{item.question}</span>
          <span class="faq-chevron" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-answer-inner" set:html={item.answer} />
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-accordion-container {
    width: 100%;
    margin: 40px 0;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .faq-title {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-top: 12px;
    margin-bottom: 10px;
  }

  .faq-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    background-color: var(--color-surface-chassis);
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-border);
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 16px;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .faq-chevron {
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 20px 20px 20px;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .faq-answer-inner {
    padding-top: 14px;
  }

  .faq-answer-inner :global(p) {
    margin-bottom: 12px;
  }

  .faq-answer-inner :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq-answer-inner :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-answer-inner :global(ul) {
    padding-left: 20px;
    margin-bottom: 12px;
  }

  .faq-answer-inner :global(li) {
    margin-bottom: 6px;
  }
</style>
