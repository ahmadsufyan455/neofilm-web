---
import { siteConfig } from '../config/site';

export interface Props {
  size?: 'normal' | 'large';
  alignment?: 'start' | 'center' | 'end';
  class?: string;
}

const { size = 'normal', alignment = 'start', class: className = '' } = Astro.props;
---

<div class:list={['store-badge-group', `align-${alignment}`, `size-${size}`, className]}>
  <!-- App Store Button -->
  <a
    href={siteConfig.stores.ios.url}
    class="store-badge-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download NeoFilm - Vintage Film Camera on the Apple App Store"
  >
    <img
      src="/images/badges/app-store-badge.svg"
      alt="Download on the App Store"
      width="120"
      height="40"
      loading="lazy"
      decoding="async"
      class="badge-img"
    />
  </a>

  <!-- Google Play Button -->
  <a
    href={siteConfig.stores.android.url}
    class="store-badge-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Get NeoFilm - Vintage Film Camera on Google Play"
  >
    <img
      src="/images/badges/google-play-badge.svg"
      alt="Get it on Google Play"
      width="135"
      height="40"
      loading="lazy"
      decoding="async"
      class="badge-img"
    />
  </a>
</div>

<style>
  .store-badge-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .align-center {
    justify-content: center;
  }

  .align-start {
    justify-content: flex-start;
  }

  .align-end {
    justify-content: flex-end;
  }

  .store-badge-link {
    display: inline-block;
    line-height: 0;
    border-radius: 8px;
    transition: transform var(--transition-fast), filter var(--transition-fast), opacity var(--transition-fast);
  }

  .store-badge-link:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .store-badge-link:active {
    transform: translateY(0);
  }

  .badge-img {
    height: 44px;
    width: auto;
    border-radius: 8px;
  }

  .size-large .badge-img {
    height: 50px;
  }

  @media (max-width: 480px) {
    .store-badge-group {
      gap: 10px;
    }
    .badge-img {
      height: 42px;
    }
  }
</style>
