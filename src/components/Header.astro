---
import { siteConfig } from '../config/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = siteConfig.navigation;

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <!-- Brand Wordmark & Logo -->
    <a href="/" class="brand-link" aria-label="NeoFilm Home">
      <div class="brand-icon-wrapper">
        <img
          src="/images/logo/neofilm-icon.png"
          alt=""
          width="36"
          height="36"
          class="brand-icon"
        />
      </div>
      <div class="brand-text">
        <span class="brand-name">{siteConfig.name}</span>
        <span class="brand-tag">VINTAGE</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (CTA) -->
    <div class="header-actions">
      <a
        href={siteConfig.stores.ios.url}
        class="btn-header-cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Download NeoFilm on the App Store"
      >
        <span class="cta-dot"></span>
        <span>Get the App</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar top"></span>
        <span class="hamburger-bar middle"></span>
        <span class="hamburger-bar bottom"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer (Rendered outside header to avoid backdrop-filter containing block trap) -->
<div
  class="mobile-nav-drawer"
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" tabindex="-1"></div>
  <div class="mobile-nav-content" id="mobile-nav-panel">
    <div class="mobile-nav-header">
      <a href="/" class="brand-link" aria-label="NeoFilm Home">
        <div class="brand-icon-wrapper">
          <img
            src="/images/logo/neofilm-icon.png"
            alt=""
            width="36"
            height="36"
            class="brand-icon"
          />
        </div>
        <div class="brand-text">
          <span class="brand-name">{siteConfig.name}</span>
          <span class="brand-tag">VINTAGE</span>
        </div>
      </a>
      <button
        type="button"
        class="mobile-nav-close"
        id="mobile-nav-close"
        aria-label="Close Navigation Menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="mobile-nav-body">
      <nav class="mobile-nav-list" aria-label="Primary Navigation">
        <span class="mobile-nav-section-title">Navigation</span>
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mobile-nav-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span class="mobile-nav-link-text">{item.label}</span>
                <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-nav-divider"></div>

      <nav class="mobile-nav-secondary" aria-label="Legal and Documentation">
        <span class="mobile-nav-section-title">Legal &amp; Policy</span>
        <ul class="mobile-secondary-list">
          <li>
            <a
              href="/privacy/"
              class:list={['mobile-secondary-link', { active: isActive('/privacy/') }]}
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms/"
              class:list={['mobile-secondary-link', { active: isActive('/terms/') }]}
            >
              Terms of Use
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mobile-nav-footer">
      <div class="mobile-download-head">
        <span class="cta-dot"></span>
        <p class="mobile-download-label">Download NeoFilm</p>
      </div>
      <div class="mobile-badge-stack">
        <a
          href={siteConfig.stores.ios.url}
          class="mobile-store-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Download NeoFilm on the App Store"
        >
          <img src="/images/badges/download_on_app_store.svg" alt="Download on the App Store" width="135" height="40" class="mobile-badge-img" />
        </a>
        <a
          href={siteConfig.stores.android.url}
          class="mobile-store-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get NeoFilm on Google Play"
        >
          <img src="/images/badges/get_it_on_google_play.svg" alt="Get it on Google Play" width="135" height="40" class="mobile-badge-img" />
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    height: var(--header-height);
    background-color: rgba(14, 14, 17, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-seam);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Brand Link */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-icon-wrapper {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-seam);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    padding: 1px 5px;
    background-color: var(--color-accent-subtle);
    border-radius: var(--radius-sm);
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 6px 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link.active {
    color: #ffffff;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
    box-shadow: 0 0 8px var(--color-accent);
  }

  /* Header CTA */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #ffffff;
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-header-cta:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .cta-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 0;
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 2000;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.28s;
  }

  .mobile-nav-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Full-viewport Backdrop */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(6, 6, 8, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.28s ease;
  }

  .mobile-nav-drawer.is-open .mobile-nav-backdrop {
    opacity: 1;
  }

  /* Solid Chassis Drawer Content */
  .mobile-nav-content {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 86vw);
    height: 100%;
    height: 100dvh;
    background-color: var(--color-surface-chassis);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0) 100%);
    border-left: 1px solid var(--color-seam);
    display: flex;
    flex-direction: column;
    padding: max(16px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)) 20px;
    box-shadow: -14px 0 40px rgba(0, 0, 0, 0.9);
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    z-index: 2001;
  }

  .mobile-nav-drawer.is-open .mobile-nav-content {
    transform: translateX(0);
  }

  /* Drawer Header */
  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-seam);
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .mobile-nav-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .mobile-nav-close:hover {
    color: #ffffff;
    border-color: var(--color-border);
    background-color: var(--color-surface-subtle);
  }

  .mobile-nav-close:active {
    transform: scale(0.96);
  }

  /* Drawer Scrollable Body */
  .mobile-nav-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .mobile-nav-section-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 8px;
    padding-left: 12px;
  }

  .mobile-nav-list ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: #ffffff;
    background-color: var(--color-surface-elevated);
    border-color: var(--color-seam);
  }

  .mobile-nav-link.active {
    color: #ffffff;
    background-color: var(--color-surface-elevated);
    border-color: rgba(255, 85, 0, 0.35);
    border-left: 3px solid var(--color-accent);
  }

  .mobile-nav-chevron {
    color: var(--color-text-dim);
    transition: color var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
  }

  .mobile-nav-link:hover .mobile-nav-chevron,
  .mobile-nav-link.active .mobile-nav-chevron {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .mobile-nav-divider {
    height: 1px;
    background-color: var(--color-seam);
    margin: 4px 0;
    flex-shrink: 0;
  }

  .mobile-secondary-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-secondary-link {
    display: block;
    padding: 9px 14px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .mobile-secondary-link:hover,
  .mobile-secondary-link.active {
    color: #ffffff;
    background-color: var(--color-surface-subtle);
  }

  .mobile-secondary-link.active {
    color: var(--color-accent);
  }

  /* Drawer Footer */
  .mobile-nav-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-seam);
    flex-shrink: 0;
  }

  .mobile-download-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .mobile-download-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .mobile-badge-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mobile-store-btn {
    display: inline-block;
    line-height: 0;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .mobile-store-btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .mobile-store-btn:active {
    transform: translateY(0);
  }

  .mobile-badge-img {
    height: 40px;
    width: auto;
    border-radius: 6px;
    display: block;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .btn-header-cta {
      display: none;
    }
    .mobile-menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Accessible Mobile Menu Toggle logic
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const closeBtn = document.getElementById('mobile-nav-close');
  const backdrop = document.getElementById('mobile-nav-backdrop');

  function openMenu() {
    if (!drawer || !toggleBtn) return;
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    toggleBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!drawer || !toggleBtn) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    toggleBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggleBtn.focus();
  }

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = drawer?.classList.contains('is-open');
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  // Close on nav link click
  const navLinks = drawer?.querySelectorAll('a');
  navLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('is-open')) {
      closeMenu();
    }
  });
</script>
