---
import { siteConfig } from '../config/site';

export interface Props { currentPath?: string; }
const { currentPath = Astro.url.pathname } = Astro.props;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="NeoFilm home">
      <img src="/images/logo/neofilm-icon.png" alt="" width="38" height="38" />
      <span>NeoFilm</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {siteConfig.navigation.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="download-link" href={siteConfig.stores.android.url} target="_blank" rel="noopener noreferrer">Get NeoFilm</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile navigation">
      {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/film-recipes/">Film recipes</a>
      <a href="/darkroom/">Darkroom</a>
      <a href={siteConfig.stores.android.url} target="_blank" rel="noopener noreferrer">Get it on Google Play</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
    if (menu) menu.hidden = open;
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; height: var(--header-height); background: rgba(12,12,14,.9); backdrop-filter: blur(16px); border-bottom: 1px solid var(--color-seam); }
  .header-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; font-size: 1.2rem; font-weight: 800; letter-spacing: -.02em; }
  .brand img { width: 38px; height: 38px; border-radius: 9px; }
  .desktop-nav { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .desktop-nav a { color: var(--color-text-secondary); font-size: .9rem; font-weight: 650; }
  .desktop-nav a:hover, .desktop-nav a.active { color: white; }
  .download-link { display: inline-flex; min-height: 42px; align-items: center; padding: 0 18px; border-radius: 9px; background: var(--color-accent); color: white; font-size: .875rem; font-weight: 750; }
  .download-link:hover { color: white; background: var(--color-accent-hover); }
  .menu-button { display: none; width: 44px; height: 44px; place-content: center; gap: 5px; border: 0; background: transparent; color: white; cursor: pointer; }
  .menu-button span { display: block; width: 21px; height: 2px; background: currentColor; }
  .mobile-menu { position: absolute; inset: var(--header-height) 0 auto; background: #101013; border-bottom: 1px solid var(--color-seam); }
  .mobile-menu nav { display: grid; padding-top: 12px; padding-bottom: 20px; }
  .mobile-menu a { min-height: 48px; display: flex; align-items: center; color: var(--color-text-secondary); border-bottom: 1px solid var(--color-seam); }
  .mobile-menu a:last-child { color: var(--color-accent-hover); border: 0; }
  @media (max-width: 760px) { .desktop-nav, .download-link { display: none; } .menu-button { display: grid; } }
</style>
