---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Features', url: '/features/' }];
---

<BaseLayout
  title="NeoFilm Features – Manual Camera, RAW DNG and Film Looks"
  description="Explore NeoFilm camera features: 30+ film-inspired looks, live preview, manual ISO, shutter and focus, DNG RAW on supported devices, custom recipes and Darkroom editing."
  canonicalPath="/features/"
  breadcrumbs={breadcrumbs}
>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Camera and editor</span>
      <h1>Creative control without a crowded workflow.</h1>
      <p class="lead">NeoFilm brings film-inspired color, supported-device manual controls, custom recipes, and editing into one focused mobile camera app.</p>
      <div class="page-links"><a href="#camera" class="btn-primary">Explore features</a><a href="/gallery/" class="btn-secondary">See sample photos</a></div>
    </div>
  </header>

  <section class="section" id="camera">
    <div class="container feature-grid">
      <div class="feature-copy"><span class="eyebrow">Capture</span><h2>See the look before you shoot.</h2><p>Preview film-inspired color in the live viewfinder and work with familiar camera aids. NeoFilm keeps the essentials close without turning the screen into a control panel.</p></div>
      <div class="card"><ul class="feature-list"><li>30+ color and monochrome profiles</li><li>Exposure controls, grids, histogram, and level</li><li>Manual ISO, shutter, focus, and focus peaking where supported</li><li>Lens switching and zoom where available</li><li>JPEG or DNG RAW capture on supported sensors</li></ul></div>
    </div>
  </section>

  <section class="section">
    <div class="container feature-grid reverse">
      <div class="feature-copy"><span class="eyebrow">Recipes</span><h2>Build a look you can reuse.</h2><p>Start with a built-in profile, then shape tone, color, texture, and framing. Save your result as a custom recipe or exchange it through a QR code.</p><a href="/film-recipes/" class="text-link">Explore film recipes</a></div>
      <div class="card"><ul class="feature-list"><li>Eight-channel HSL controls</li><li>Exposure, contrast, highlights, shadows, whites, and blacks</li><li>Temperature, tint, vibrance, and saturation</li><li>Grain, halation, bloom, fade, and vignette</li><li>Light leaks, dust, borders, and crop controls</li></ul></div>
    </div>
  </section>

  <section class="section">
    <div class="container feature-grid">
      <div class="feature-copy"><span class="eyebrow">Darkroom</span><h2>Finish photos already on your device.</h2><p>Import a photo, apply a profile or recipe, refine it, and export a single image or a film-inspired layout. Processing happens on your device.</p><a href="/darkroom/" class="text-link">Learn about the Darkroom</a></div>
      <div class="card"><ul class="feature-list"><li>Re-edit photos from your library</li><li>Individual and batch workflows</li><li>Film strips and contact-sheet layouts</li><li>High-quality JPEG export</li><li>Optional city labels when location access is enabled</li></ul></div>
    </div>
  </section>

  <section class="feature-cta"><div class="container-narrow"><h2>Available for Android and iPhone.</h2><p>Requires Android 8.0+ or iOS 17+. RAW and manual features depend on device hardware.</p><StoreBadgeButtons size="large" alignment="center" /></div></section>
</BaseLayout>

<style>
  .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 9vw, 120px); align-items: center; }
  .feature-grid.reverse .feature-copy { order: 2; }
  .feature-copy h2 { margin: 12px 0 18px; }
  .feature-copy p { max-width: 580px; }
  .card { padding: clamp(28px, 5vw, 46px); }
  .feature-cta { padding: 96px 0; border-top: 1px solid var(--color-seam); text-align: center; }
  .feature-cta p { margin: 14px 0 28px; }
  @media (max-width: 760px) { .feature-grid { grid-template-columns: 1fr; } .feature-grid.reverse .feature-copy { order: initial; } }
</style>
