---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Darkroom', url: '/darkroom/' }];
---

<BaseLayout
  title="NeoFilm Darkroom – Mobile Film Photo Editor"
  description="Edit photos on your device with NeoFilm profiles and recipes, then export high-quality images, film strips and contact-sheet layouts from the mobile Darkroom."
  canonicalPath="/darkroom/"
  breadcrumbs={breadcrumbs}
>
  <header class="page-hero">
    <div class="container hero-layout">
      <div><span class="eyebrow">Mobile film photo editor</span><h1>A focused Darkroom for the photos you already have.</h1><p class="lead">Import from your photo library, apply a profile or recipe, refine the result, and export—all on your device.</p></div>
      <img src="/images/samples/sample-darkroom.jpg" alt="NeoFilm Darkroom editing interface" width="1080" height="2192" />
    </div>
  </header>

  <section class="section">
    <div class="container workflow">
      <article><span>01</span><h2>Choose a photo.</h2><p>Open an image from your device and begin with the original or one of NeoFilm’s film-inspired profiles.</p></article>
      <article><span>02</span><h2>Shape the finish.</h2><p>Apply a saved recipe or adjust color, tone, grain, halation, bloom, vignette, and other available controls.</p></article>
      <article><span>03</span><h2>Export your way.</h2><p>Save a high-quality JPEG, process a selection, or create a film strip or contact-sheet layout.</p></article>
    </div>
  </section>

  <section class="section formats-section">
    <div class="container formats-grid">
      <div><span class="eyebrow">Output formats</span><h2>More than a single frame.</h2><p>NeoFilm includes film-inspired presentation tools for sharing a sequence, a contact sheet, or an individual photo.</p></div>
      <div class="card"><ul class="feature-list"><li>Individual high-quality JPEG export</li><li>Batch workflow, with unlimited batch export in Pro</li><li>Film-strip presentation</li><li>Story 9:16 and Feed 4:5 contact-sheet layouts</li><li>Optional labels and framing controls</li></ul></div>
    </div>
  </section>

  <section class="privacy-note"><div class="container-narrow"><span class="eyebrow">On-device workflow</span><h2>Your photos stay in your workflow.</h2><p>NeoFilm performs photo capture and editing on your device and does not upload your photo library to NeoFilm-operated servers. System photo and location permissions remain under your device controls.</p><a href="/privacy/" class="text-link">Read the privacy policy</a></div></section>
  <section class="darkroom-cta"><div class="container-narrow"><h2>Develop your next frame.</h2><StoreBadgeButtons size="large" alignment="center" /></div></section>
</BaseLayout>

<style>
  .hero-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(40px, 8vw, 100px); align-items: center; }
  .hero-layout img { width: min(100%, 350px); height: auto; justify-self: center; border-radius: var(--radius-xl); }
  .workflow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .workflow article { padding-right: 28px; }
  .workflow article:not(:last-child) { border-right: 1px solid var(--color-seam); }
  .workflow span { color: var(--color-accent); font-family: var(--font-mono); font-size: .72rem; }
  .workflow h2 { margin: 24px 0 13px; font-size: 1.55rem; }
  .formats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 9vw, 120px); align-items: center; }
  .formats-grid h2, .privacy-note h2 { margin: 12px 0 16px; }
  .privacy-note { padding: 90px 0; border-top: 1px solid var(--color-seam); text-align: center; background: var(--color-surface-chassis); }
  .darkroom-cta { padding: 90px 0; text-align: center; }
  .darkroom-cta h2 { margin-bottom: 28px; }
  @media (max-width: 760px) { .hero-layout, .workflow, .formats-grid { grid-template-columns: 1fr; } .workflow article { padding: 0 0 28px; border-right: 0 !important; border-bottom: 1px solid var(--color-seam); } }
</style>
