---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';
import { samplePhotos } from '../data/samplePhotos';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Gallery', url: '/gallery/' }];
const photos = samplePhotos;
---

<BaseLayout
  title="NeoFilm Sample Photos – Film-Inspired Mobile Photography"
  description="View sample photos processed with NeoFilm profiles including Amber Transit 200, Vista Color 200, Superia 400 and Instant Memory 600."
  canonicalPath="/gallery/"
  breadcrumbs={breadcrumbs}
>
  <header class="page-hero gallery-hero"><div class="container"><span class="eyebrow">NeoFilm gallery</span><h1>Film-inspired color in the real world.</h1><p class="lead">A selection of photos processed with NeoFilm. Profile names are shown for reference; results vary with light, sensor, and recipe settings.</p></div></header>

  <section class="section">
    <div class="container gallery-grid">
      {photos.map((photo) => (
        <figure>
          <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open ${photo.title} at full size`}>
            <img src={photo.thumbSrc ?? photo.src} alt={`${photo.title}, processed with ${photo.filmProfile} in NeoFilm`} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </a>
          <figcaption><strong>{photo.title}</strong><span>{photo.filmProfile}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="gallery-cta"><div class="container-narrow"><span class="eyebrow">Create your own</span><h2>A camera and Darkroom in one app.</h2><p>Get NeoFilm for Android or iPhone.</p><StoreBadgeButtons size="large" alignment="center" /></div></section>
</BaseLayout>

<style>
  .gallery-grid { columns: 3; column-gap: 18px; }
  figure { break-inside: avoid; margin-bottom: 18px; overflow: hidden; border: 1px solid var(--color-seam); border-radius: var(--radius-lg); background: var(--color-surface-chassis); }
  figure a { display: block; overflow: hidden; }
  figure img { width: 100%; height: auto; transition: transform 350ms ease; }
  figure a:hover img { transform: scale(1.015); }
  figcaption { display: grid; gap: 3px; padding: 14px 16px; }
  figcaption strong { font-size: .88rem; }
  figcaption span { color: var(--color-text-muted); font-family: var(--font-mono); font-size: .7rem; }
  .gallery-cta { padding: 96px 0; border-top: 1px solid var(--color-seam); text-align: center; }
  .gallery-cta h2 { margin: 12px 0 14px; }
  .gallery-cta p { margin-bottom: 28px; }
  @media (max-width: 820px) { .gallery-grid { columns: 2; } }
  @media (max-width: 520px) { .gallery-grid { columns: 1; } }
</style>
