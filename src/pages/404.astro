---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found – NeoFilm"
  description="The NeoFilm page you requested could not be found."
  canonicalPath="/404"
>
  <section class="not-found">
    <div class="container-narrow">
      <span class="eyebrow">Error 404</span>
      <h1>This frame is empty.</h1>
      <p class="lead">The page may have moved, or the address may be incomplete.</p>
      <div class="page-links"><a href="/" class="btn-primary">Return home</a><a href="/support/" class="btn-secondary">Visit support</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 65vh; display: grid; place-items: center; padding: 100px 0; text-align: center; }
  h1 { margin: 12px 0 18px; font-size: clamp(3rem, 9vw, 6rem); }
  .page-links { justify-content: center; }
</style>
