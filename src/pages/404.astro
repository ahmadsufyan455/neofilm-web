---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';
---

<BaseLayout
  title="404 – Frame Not Found | NeoFilm"
  description="The requested page or frame could not be located in the NeoFilm roll."
  canonicalPath="/404/"
  includeSmartBanner={false}
>
  <div class="notfound-wrapper">
    <div class="container text-center">
      <div class="chassis-card notfound-card">
        <span class="badge-mono badge-accent">EXPOSURE ERROR · 404</span>
        <div class="counter-display" aria-hidden="true">
          <span class="digit">E</span>
          <span class="digit">X</span>
          <span class="digit">P</span>
          <span class="digit spacer">·</span>
          <span class="digit accent">0</span>
          <span class="digit accent">0</span>
        </div>
        <h1 class="notfound-h1">Frame Not Found</h1>
        <p class="notfound-lead">
          The frame you are trying to view has not been exposed or has been moved to another canister roll.
        </p>

        <div class="notfound-nav-links">
          <a href="/" class="btn-primary">Return to Viewfinder</a>
          <a href="/features/" class="btn-secondary">Explore Features</a>
          <a href="/support/" class="btn-secondary">Get Support</a>
        </div>

        <div class="notfound-badges">
          <p class="badge-label">Available for iPhone and Android</p>
          <StoreBadgeButtons size="normal" alignment="center" />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-wrapper {
    padding: 80px 0 120px 0;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
  }

  .text-center {
    text-align: center;
  }

  .notfound-card {
    max-width: 640px;
    margin: 0 auto;
    padding: 64px 32px;
    background-image: 
      radial-gradient(ellipse 60% 60% at 50% 0%, rgba(255, 85, 0, 0.08), transparent 70%),
      linear-gradient(180deg, #18181c 0%, #101012 100%);
  }

  .counter-display {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 28px 0;
    font-family: var(--font-mono);
  }

  .digit {
    background-color: #0c0c0e;
    border: 1px solid var(--color-seam);
    color: #e4e4eb;
    font-size: 2.25rem;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .digit.spacer {
    background: transparent;
    border: none;
    padding: 10px 4px;
    box-shadow: none;
    color: var(--color-text-dim);
  }

  .digit.accent {
    color: var(--color-accent);
    text-shadow: 0 0 12px var(--color-accent);
  }

  .notfound-h1 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    margin-bottom: 14px;
  }

  .notfound-lead {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0 auto 36px auto;
    line-height: 1.6;
  }

  .notfound-nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-bottom: 48px;
  }

  .notfound-badges {
    border-top: 1px solid var(--color-seam);
    padding-top: 32px;
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  @media (max-width: 480px) {
    .digit {
      font-size: 1.5rem;
      padding: 8px 10px;
    }
    .notfound-nav-links {
      flex-direction: column;
    }
    .notfound-nav-links a {
      width: 100%;
    }
  }
</style>
