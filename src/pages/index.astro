---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';

const faqItems = [
  { question: 'Is NeoFilm available for iPhone and Android?', answer: 'Yes. NeoFilm supports iPhone and Android, with the same core camera, recipe, and Darkroom experience on both platforms.' },
  { question: 'Can NeoFilm capture RAW photos?', answer: 'NeoFilm can capture DNG RAW files on supported devices and sensors. Hardware capabilities vary by device.' },
  { question: 'Does NeoFilm upload my photos?', answer: 'Photo capture and editing happen on your device. NeoFilm does not upload your photo library to NeoFilm-operated servers.' },
  { question: 'What is included with NeoFilm Pro?', answer: 'NeoFilm Pro unlocks the complete profile collection and advanced tools such as supported-device manual and RAW capture, custom recipes, and unlimited batch export. Available products and trials are shown in the app.' },
];
---

<BaseLayout
  title="NeoFilm – Vintage Film Camera App for Android & iPhone"
  description="Capture and edit on Android and iPhone with 30+ film-inspired looks, custom recipes, supported-device manual and RAW controls, and a mobile Darkroom."
  canonicalPath="/"
  faqItems={faqItems}
  includeAppSchema={true}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Vintage film camera for Android &amp; iPhone</span>
        <h1>Make digital photos feel <em>remembered.</em></h1>
        <p class="lead">NeoFilm combines a live film-inspired camera, detailed custom recipes, and a focused mobile Darkroom.</p>
        <StoreBadgeButtons size="large" />
        <p class="compatibility">Android 8.0+ · iOS 17+ · Camera features vary by device</p>
      </div>
      <div class="hero-image">
        <img src="/images/samples/sample-portra.jpg" alt="Suspension bridge photo processed with NeoFilm Portra Warm 400" width="1384" height="1024" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="what-title">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">One camera, three ways to create</span>
        <h2 id="what-title">A simpler path from capture to finish.</h2>
      </div>
      <div class="cards-3">
        <article class="card">
          <span class="card-number">01</span>
          <h3>Film-inspired camera</h3>
          <p>Preview 30+ color and monochrome looks while you frame, then shoot JPEG or supported-device DNG RAW.</p>
          <a href="/features/" class="text-link">Explore camera features</a>
        </article>
        <article class="card">
          <span class="card-number">02</span>
          <h3>Custom film recipes</h3>
          <p>Tune color, tone, grain, halation, bloom, light leaks, dust, borders, and framing. Share recipes with QR codes.</p>
          <a href="/film-recipes/" class="text-link">Build your look</a>
        </article>
        <article class="card">
          <span class="card-number">03</span>
          <h3>Mobile Darkroom</h3>
          <p>Rework photos already on your device and export individual images, film strips, or contact-sheet layouts.</p>
          <a href="/darkroom/" class="text-link">Visit the Darkroom</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section sample-section" aria-labelledby="samples-title">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Made with NeoFilm</span>
        <h2 id="samples-title">Color with character, not clutter.</h2>
        <p>Sample photos processed with current NeoFilm profiles.</p>
      </div>
      <div class="sample-grid">
        <figure><img src="/images/photos/thumbs/NeoFilm_Darkroom_1788072227833.webp" alt="Suramadu Bridge pylon processed with NeoFilm Superia 400" width="750" height="1000" loading="lazy" /><figcaption>Superia 400</figcaption></figure>
        <figure><img src="/images/photos/thumbs/NeoFilm_Darkroom_1789347946075.webp" alt="Chinatown street market processed with NeoFilm FX Daily 400" width="750" height="1000" loading="lazy" /><figcaption>FX Daily 400</figcaption></figure>
        <figure><img src="/images/photos/thumbs/NeoFilm_Export_1789347779023.webp" alt="Pastel heritage shophouses processed with NeoFilm FX Daily 400" width="750" height="1000" loading="lazy" /><figcaption>FX Daily 400</figcaption></figure>
      </div>
      <a class="text-link" href="/gallery/">View the gallery</a>
    </div>
  </section>

  <section class="section pro-section" aria-labelledby="pro-title">
    <div class="container pro-grid">
      <div>
        <span class="eyebrow">NeoFilm Pro</span>
        <h2 id="pro-title">More control when you want it.</h2>
        <p class="lead">Unlock the complete profile collection, advanced capture tools, unlimited custom recipes, and unlimited batch export.</p>
      </div>
      <div class="pro-card">
        <ul class="feature-list">
          <li>30+ built-in film-inspired profiles</li>
          <li>Manual ISO, shutter, and focus on supported devices</li>
          <li>DNG RAW capture on supported sensors</li>
          <li>Unlimited recipes and QR sharing</li>
          <li>Monthly, annual, and one-time purchase options</li>
        </ul>
        <p>Products, prices, trial eligibility, and renewal terms are shown in the app before purchase.</p>
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="section-heading"><span class="eyebrow">Useful details</span><h2 id="faq-title">Before you download.</h2></div>
      <div class="faq-list">
        {faqItems.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container-narrow">
      <span class="eyebrow">Start shooting</span>
      <h2>Your camera roll, with more feeling.</h2>
      <p>Download NeoFilm for Android or iPhone.</p>
      <StoreBadgeButtons size="large" alignment="center" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(70px, 10vw, 130px) 0 clamp(80px, 12vw, 140px); }
  .hero-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(40px, 7vw, 88px); align-items: center; }
  .hero-copy h1 { margin: 16px 0 24px; }
  .hero-copy h1 em { color: var(--color-accent-hover); font-style: normal; }
  .hero-copy .lead { max-width: 620px; margin-bottom: 30px; }
  .compatibility { margin-top: 15px; color: var(--color-text-muted); font-size: .76rem; }
  .hero-image { position: relative; border-radius: 26px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,.46); }
  .hero-image::after { content: ""; position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.12); border-radius: inherit; pointer-events: none; }
  .hero-image img { width: 100%; min-height: 470px; object-fit: cover; }
  .card-number { display: block; margin-bottom: 28px; color: var(--color-accent); font-family: var(--font-mono); font-size: .72rem; }
  .sample-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  figure { position: relative; min-height: 360px; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-surface-chassis); }
  figure img { width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease; }
  figcaption { position: absolute; left: 14px; bottom: 14px; padding: 6px 10px; border-radius: 6px; background: rgba(8,8,10,.78); color: white; font-size: .72rem; font-family: var(--font-mono); }
  .pro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 8vw, 100px); align-items: center; }
  .pro-grid h2 { margin: 12px 0 18px; }
  .pro-card { padding: 34px; border: 1px solid rgba(255,85,0,.35); border-radius: var(--radius-xl); background: linear-gradient(145deg, rgba(255,85,0,.08), transparent), var(--color-surface-chassis); }
  .pro-card p { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--color-seam); font-size: .78rem; }
  .faq-grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: 70px; }
  .faq-list { border-top: 1px solid var(--color-seam); }
  details { border-bottom: 1px solid var(--color-seam); }
  summary { cursor: pointer; padding: 21px 34px 21px 0; color: white; font-weight: 700; }
  details p { padding: 0 0 22px; font-size: .95rem; }
  .final-cta { padding: 100px 0; border-top: 1px solid var(--color-seam); text-align: center; background: radial-gradient(circle, rgba(255,85,0,.1), transparent 65%); }
  .final-cta h2 { margin: 12px 0 15px; }
  .final-cta p { margin-bottom: 28px; }
  @media (hover: hover) and (pointer: fine) { figure:hover img { transform: scale(1.018); } }
  @media (max-width: 860px) { .hero-grid, .pro-grid, .faq-grid { grid-template-columns: 1fr; } .hero-image img { min-height: 340px; } .sample-grid { grid-template-columns: 1fr 1fr; } .sample-grid figure:last-child { grid-column: 1 / -1; max-height: 520px; } }
  @media (max-width: 560px) { .sample-grid { grid-template-columns: 1fr; } .sample-grid figure:last-child { grid-column: auto; } figure { min-height: 330px; } }
</style>
