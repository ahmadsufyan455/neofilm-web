---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadgeButtons from '../components/StoreBadgeButtons.astro';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Film Recipes', url: '/film-recipes/' }];
const examples = ['Portra Warm 400', 'Tri-X Mono 400', 'Vision Cinema 500T', 'Instant Memory 600', 'Superia 400', 'Amber Transit 200'];
---

<BaseLayout
  title="Custom Film Recipes and Vintage Photo Filters – NeoFilm"
  description="Create custom film recipes in NeoFilm with HSL color, tone, grain, halation, bloom, light leaks, borders and framing. Save or share recipes with QR codes."
  canonicalPath="/film-recipes/"
  breadcrumbs={breadcrumbs}
>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Custom film recipes</span>
      <h1>Start with a profile. Make the look yours.</h1>
      <p class="lead">NeoFilm includes 30+ film-inspired looks and a recipe editor for building a consistent visual style across camera and Darkroom photos.</p>
    </div>
  </header>

  <section class="section">
    <div class="container recipe-grid">
      <div>
        <span class="eyebrow">Recipe controls</span>
        <h2>Color, tone, texture, and frame.</h2>
        <p>Adjust only what matters for your look. Recipes keep these choices together, so you can return to them without rebuilding every edit.</p>
      </div>
      <div class="control-groups">
        <article><h3>Color</h3><p>Eight-channel HSL, temperature, tint, vibrance, saturation, and split toning.</p></article>
        <article><h3>Tone</h3><p>Exposure, contrast, highlights, shadows, whites, blacks, fade, and density.</p></article>
        <article><h3>Texture</h3><p>Grain, halation, bloom, vignette, light leaks, and dust.</p></article>
        <article><h3>Frame</h3><p>Borders, aspect ratios, crop, and film-inspired presentation controls.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container share-grid">
      <div class="share-card"><span>01</span><h3>Create</h3><p>Choose a profile and tune it in the recipe editor.</p></div>
      <div class="share-card"><span>02</span><h3>Save</h3><p>Name the recipe and keep it ready for future photos.</p></div>
      <div class="share-card"><span>03</span><h3>Share</h3><p>Export a QR code so another NeoFilm user can import the settings.</p></div>
    </div>
  </section>

  <section class="section examples-section">
    <div class="container examples-grid">
      <div><span class="eyebrow">A few current profiles</span><h2>Designed as starting points.</h2><p>Names and availability may evolve as NeoFilm adds and refines its collection.</p></div>
      <ul>{examples.map((name) => <li>{name}</li>)}</ul>
    </div>
  </section>

  <section class="recipes-cta"><div class="container-narrow"><h2>Build a reusable look.</h2><p>Get NeoFilm for Android or iPhone.</p><StoreBadgeButtons size="large" alignment="center" /></div></section>
</BaseLayout>

<style>
  .recipe-grid, .examples-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(40px, 9vw, 120px); }
  .recipe-grid h2, .examples-grid h2 { margin: 12px 0 16px; }
  .control-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .control-groups article, .share-card { padding: 24px; border: 1px solid var(--color-seam); border-radius: var(--radius-lg); background: var(--color-surface-chassis); }
  .control-groups h3, .share-card h3 { margin-bottom: 8px; }
  .control-groups p, .share-card p { font-size: .92rem; }
  .share-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .share-card span { display: block; margin-bottom: 40px; color: var(--color-accent); font-family: var(--font-mono); font-size: .72rem; }
  .examples-grid ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .examples-grid li { padding: 16px 18px; border-bottom: 1px solid var(--color-seam); color: var(--color-text-primary); font-family: var(--font-mono); font-size: .85rem; }
  .recipes-cta { padding: 96px 0; border-top: 1px solid var(--color-seam); text-align: center; }
  .recipes-cta p { margin: 14px 0 28px; }
  @media (max-width: 760px) { .recipe-grid, .examples-grid, .share-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .control-groups, .examples-grid ul { grid-template-columns: 1fr; } }
</style>
