---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Support', url: '/support/' }];
const faqItems = [
  { question: 'Why is RAW capture unavailable?', answer: 'DNG RAW depends on the camera sensor and Android camera capabilities reported by your device. Some lenses or devices may support JPEG capture only.' },
  { question: 'How do I restore NeoFilm Pro?', answer: 'Open the Pro screen in NeoFilm and choose Restore Purchases while signed in to the same store account used for the original purchase.' },
  { question: 'Where are my custom recipes stored?', answer: 'Recipes and settings are stored on your device. Android system backup may include eligible app data when backup is enabled for your Google account.' },
  { question: 'Why does NeoFilm request location access?', answer: 'Location is optional and can be used for city labels or photo metadata. Camera and editing features continue to work when location access is denied.' },
  { question: 'Does NeoFilm support iPhone and Android?', answer: 'Yes. NeoFilm supports iPhone and Android. Camera capabilities such as RAW and manual controls depend on the device hardware.' },
];
---

<BaseLayout
  title="NeoFilm Support – Help, Permissions and Purchase Restore"
  description="Get help with NeoFilm camera permissions, supported-device RAW capture, photo access, location labels, subscriptions and restoring purchases."
  canonicalPath="/support/"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <header class="page-hero"><div class="container"><span class="eyebrow">Support</span><h1>Quick answers, without the manual.</h1><p class="lead">Start with the common fixes below. If you still need help, email us with your device model, operating-system version, and a short description of the issue.</p><div class="page-links"><a class="btn-primary" href={`mailto:${siteConfig.supportEmail}`}>Email support</a></div></div></header>

  <section class="section">
    <div class="container support-grid">
      <aside>
        <a href="#permissions">Permissions</a><a href="#purchases">Purchases</a><a href="#faq">Common questions</a>
      </aside>
      <div class="support-content">
        <section id="permissions">
          <span class="eyebrow">Permissions</span><h2>Camera, photos, and optional location.</h2>
          <div class="help-cards">
            <article><h3>Camera</h3><p>Required to use the NeoFilm viewfinder and capture photos. Enable it in your device’s app settings if the preview is unavailable.</p></article>
            <article><h3>Photos and storage</h3><p>Used when you import an existing image or save an export. On newer systems, you can limit access to selected photos.</p></article>
            <article><h3>Location</h3><p>Optional. Used for location-based labels or metadata when you choose to enable it. NeoFilm remains usable without it.</p></article>
          </div>
        </section>

        <section id="purchases">
          <span class="eyebrow">NeoFilm Pro</span><h2>Manage purchases through your store account.</h2>
          <p>Prices, trial eligibility, renewal details, and available products appear in the app before purchase. Billing and cancellation are managed through Google Play or Apple. RevenueCat helps NeoFilm validate access to Pro features.</p>
          <ul class="feature-list"><li>Use Restore Purchases after reinstalling or changing devices.</li><li>Confirm you are signed in to the original store account.</li><li>Manage or cancel a subscription in your store account settings.</li><li>Contact support if access is not restored after the store confirms the purchase.</li></ul>
        </section>

        <section id="faq">
          <span class="eyebrow">FAQ</span><h2>Common questions.</h2>
          <div class="faq-list">{faqItems.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .support-grid { display: grid; grid-template-columns: 190px 1fr; gap: clamp(36px, 8vw, 100px); align-items: start; }
  aside { position: sticky; top: calc(var(--header-height) + 24px); display: grid; }
  aside a { padding: 11px 0; border-bottom: 1px solid var(--color-seam); color: var(--color-text-secondary); font-size: .9rem; }
  .support-content { display: grid; gap: 86px; }
  .support-content h2 { margin: 12px 0 20px; }
  .help-cards { display: grid; gap: 14px; }
  .help-cards article { padding: 22px 24px; border: 1px solid var(--color-seam); border-radius: var(--radius-lg); background: var(--color-surface-chassis); }
  .help-cards h3 { margin-bottom: 6px; }
  .help-cards p { font-size: .94rem; }
  #purchases > p { margin-bottom: 24px; }
  .faq-list { border-top: 1px solid var(--color-seam); }
  details { border-bottom: 1px solid var(--color-seam); }
  summary { cursor: pointer; padding: 20px 32px 20px 0; color: white; font-weight: 700; }
  details p { padding-bottom: 20px; font-size: .94rem; }
  @media (max-width: 700px) { .support-grid { grid-template-columns: 1fr; } aside { position: static; grid-template-columns: repeat(3, 1fr); gap: 8px; } aside a { text-align: center; border: 1px solid var(--color-seam); border-radius: 7px; font-size: .78rem; } }
</style>
