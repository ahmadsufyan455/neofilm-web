---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'NeoFilm Lab for macOS', url: '/lab/' },
];

const faqItems = [
  {
    question: 'Is NeoFilm Lab a subscription or a one-time purchase?',
    answer:
      'NeoFilm Lab is normally a $9.99 one-time purchase, currently $5.99 with 40% launch discount code NEOFILM40 (auto-applied at checkout). There are no recurring subscriptions—you receive a perpetual license key by email immediately after checkout.',
  },
  {
    question: 'How many Macs can I activate with one license?',
    answer:
      'One license key can be active on up to two Macs at the same time (for example, your studio Mac desktop and your MacBook). You can deactivate a Mac anytime from NeoFilm Lab → Settings to move your activation slot to a new computer.',
  },
  {
    question: 'Are recipes created in NeoFilm Lab compatible with iPhone and Android?',
    answer:
      'Yes. NeoFilm Lab shares the exact same color science and film profiles as the NeoFilm mobile app. Click Share / QR in NeoFilm Lab to generate a scannable QR Recipe Card or export a recipe JSON file that opens directly in NeoFilm on iPhone and Android.',
  },
  {
    question: 'Which camera RAW formats and macOS versions are supported?',
    answer:
      'NeoFilm Lab runs natively on macOS 14.0 (Sonoma) or later on both Apple Silicon (M1–M4) and Intel Macs. It supports camera RAW files (.CR3, .CR2, .ARW, .NEF, .RAF, .DNG, .ORF, .RW2) as well as JPEG, HEIC, PNG, and 16-bit TIFF.',
  },
  {
    question: 'Does NeoFilm Lab work offline?',
    answer:
      'Yes. All RAW decoding and Metal GPU color grading run 100% locally on your Mac. Once your license key is activated, NeoFilm Lab caches your activation securely in the macOS Keychain for offline work.',
  },
];
---

<BaseLayout
  title="NeoFilm Lab for macOS – Analog Film Color Grading & RAW Workbench"
  description="Craft your signature film look on macOS. Develop RAW and high-resolution photos with 39+ film stocks, real-time Metal GPU grading, and instant QR recipe sync to iPhone and Android. $9.99 one-time purchase."
  canonicalPath="/lab/"
  ogImage="/images/og/og-lab.jpg"
  ogImageAlt="NeoFilm Lab for macOS – Analog Film Color Grading and RAW Workbench"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  includeMacAppSchema={true}
>
  <!-- Hero Section -->
  <section class="lab-hero">
    <div class="container">
      <div class="hero-header">
        <div class="badge-row">
          <span class="eyebrow">NeoFilm Lab for macOS</span>
          <span class="version-pill">v{siteConfig.stores.macLab.version} · Universal Mac App</span>
        </div>
        <h1>Craft your signature film look <em>on Mac.</em></h1>
        <p class="lead">
          The native macOS photo editor and film-recipe workbench for the NeoFilm ecosystem.
          Grade camera RAW and high-resolution frames at 60fps with Metal, then sync your custom recipes straight to your phone via QR.
        </p>

        <div class="cta-group">
          <a
            href={siteConfig.stores.macLab.checkoutUrl}
            class="btn-buy"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Buy NeoFilm Lab</span>
            <span class="price-tag">
              <s class="price-strike">{siteConfig.stores.macLab.originalPrice}</s>
              <span class="price-current">{siteConfig.stores.macLab.price}</span>
            </span>
          </a>
          <a href="#workflow" class="btn-secondary">Explore the Workbench</a>
        </div>

        <p class="hero-meta">
          <span class="discount-pill">40% OFF with code NEOFILM40</span> · One-time purchase · 2 Macs per license · {siteConfig.stores.macLab.minTarget}
        </p>
      </div>

      <figure class="hero-showcase">
        <img
          src="/images/lab/lab-workbench-hero.webp"
          alt="NeoFilm Lab macOS workbench editing a Canon EOS R50 CR3 RAW photo with Moody Warm 400 film stock"
          width="1456"
          height="964"
          fetchpriority="high"
        />
        <figcaption class="showcase-bar">
          <span><strong>39+</strong> Film Stocks</span>
          <span class="dot">·</span>
          <span><strong>RAW / DNG / HEIC / TIFF</strong> Support</span>
          <span class="dot">·</span>
          <span><strong>Metal GPU</strong> Pipeline</span>
          <span class="dot">·</span>
          <span><strong>QR Sync</strong> to iOS &amp; Android</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Split Compare Feature Section -->
  <section class="section" id="workflow" aria-labelledby="compare-title">
    <div class="container feature-split">
      <div class="feature-copy">
        <span class="eyebrow">Real-time Metal Color Science</span>
        <h2 id="compare-title">See every nuance before and after.</h2>
        <p class="lead">
          Press <kbd>\</kbd> or drag the interactive split wipe to compare your ungraded camera RAW against your developed film stock in real time.
        </p>
        <ul class="feature-list">
          <li><strong>39+ calibrated film stocks</strong> across Warm &amp; Golden, Daylight &amp; Cinema, Cool &amp; Slide, Black &amp; White, and Experimental categories</li>
          <li><strong>Full tonal &amp; color precision:</strong> Exposure, Contrast, Highlights, Shadows, Whites, Blacks, White Balance (Kelvin &amp; Tint), Vibrance, and Saturation</li>
          <li><strong>8-Channel HSL Color Mixer &amp; Split Toning:</strong> Shape individual hue, saturation, and luminance bands plus shadow/highlight color balance</li>
          <li><strong>Parametric Tone Curves:</strong> Sculpt film toe and shoulder roll-off with tactile precision</li>
        </ul>
      </div>
      <div class="feature-visual">
        <img
          src="/images/lab/lab-split-compare.webp"
          alt="Interactive before and after split comparison in NeoFilm Lab showing Velvia Vivid 50 slide film on a coastal RAW photo"
          width="1624"
          height="1052"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- QR Recipe Sync Feature Section -->
  <section class="section qr-section" aria-labelledby="qr-title">
    <div class="container feature-split reverse">
      <div class="feature-visual">
        <img
          src="/images/lab/lab-qr-sync.webp"
          alt="NeoFilm Lab Share Film Recipe modal displaying a scannable QR Recipe Card for Velvia Vivid 50"
          width="1624"
          height="1052"
          loading="lazy"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">Desktop-to-Camera Ecosystem</span>
        <h2 id="qr-title">Build on Mac. Shoot live on iPhone &amp; Android.</h2>
        <p class="lead">
          Your desktop color grading and your pocket camera now speak the exact same language.
        </p>
        <ul class="feature-list">
          <li><strong>Instant QR Recipe Cards:</strong> Generate a shareable visual recipe card with a scannable QR code in one click (<kbd>⇧⌘S</kbd>)</li>
          <li><strong>1:1 Color Parity:</strong> Scan the QR code in NeoFilm on iPhone or Android and preview that exact look live through your camera viewfinder</li>
          <li><strong>JSON Recipe Import &amp; Export:</strong> Back up your custom film looks or share recipe files with other photographers</li>
          <li><strong>Saved Recipe Shelf:</strong> Build a personal library of signature looks right alongside the built-in film stocks</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 6-Card Capability Grid -->
  <section class="section" aria-labelledby="capabilities-title">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Built for Photographers</span>
        <h2 id="capabilities-title">A complete analog darkroom for macOS.</h2>
        <p>Engineered natively with SwiftUI, AppKit, and Metal for instantaneous feedback on high-megapixel files.</p>
      </div>

      <div class="cards-3">
        <article class="card">
          <span class="card-number">01</span>
          <h3>Camera RAW &amp; 16-Bit Pipeline</h3>
          <p>Open Canon CR3/CR2, Sony ARW, Nikon NEF, Fujifilm RAF, DNG, HEIC, TIFF, and JPEG with full EXIF lens and shutter readouts.</p>
        </article>
        <article class="card">
          <span class="card-number">02</span>
          <h3>Grain, Halation &amp; Bloom</h3>
          <p>Add organic silver-halide grain structure, red-emulsion halation around bright light sources, and subtle highlight bloom.</p>
        </article>
        <article class="card">
          <span class="card-number">03</span>
          <h3>Studio Borders &amp; EXIF Stamps</h3>
          <p>Frame your exports with gallery mattes or instant-film borders and optional camera metadata stamps (camera model, focal length, aperture, shutter, ISO).</p>
        </article>
        <article class="card">
          <span class="card-number">04</span>
          <h3>Collections &amp; Batch Grading</h3>
          <p>Organize shoots into custom groups, copy adjustments (<kbd>⇧⌘C</kbd>) and paste them across an entire roll (<kbd>⇧⌘V</kbd>) in seconds.</p>
        </article>
        <article class="card">
          <span class="card-number">05</span>
          <h3>Keyboard-First Workflow</h3>
          <p>Toggle sidebars (<kbd>⌥⌘I</kbd>), preset shelf (<kbd>⌥⌘P</kbd>), 100% zoom (<kbd>⌘0</kbd>), fit canvas (<kbd>⌘9</kbd>), and before/after split (<kbd>\</kbd>) without touching the mouse.</p>
        </article>
        <article class="card">
          <span class="card-number">06</span>
          <h3>100% Local &amp; Private</h3>
          <p>Your photos never leave your Mac. Zero cloud uploads, no mandatory accounts, and full offline editing once activated.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Pricing & License Section -->
  <section class="section buy-section" id="buy" aria-labelledby="pricing-title">
    <div class="container pricing-grid">
      <div class="pricing-copy">
        <span class="eyebrow">Launch Celebration Offer</span>
        <h2 id="pricing-title">Pay once. Own your darkroom.</h2>
        <p class="lead">
          No monthly subscriptions. Get NeoFilm Lab for just <strong>{siteConfig.stores.macLab.price}</strong> <s class="copy-strike">{siteConfig.stores.macLab.originalPrice}</s> with 40% launch discount code <strong>NEOFILM40</strong> auto-applied.
        </p>
        <div class="ownership-highlights">
          <div>
            <strong>2 Active Macs Included</strong>
            <p>Install on both your desktop Mac and your MacBook with a single license key. Deactivate and transfer anytime inside Settings.</p>
          </div>
          <div>
            <strong>Notarized by Apple</strong>
            <p>Signed with Developer ID and notarized by Apple for macOS 14 Sonoma and later (Universal binary for Apple Silicon &amp; Intel).</p>
          </div>
        </div>
      </div>

      <div class="pricing-card">
        <div class="pricing-card-top">
          <div>
            <span class="plan-label">Direct License · macOS</span>
            <h3>NeoFilm Lab</h3>
          </div>
          <div class="price-block">
            <div class="price-row">
              <span class="price-strike-large">{siteConfig.stores.macLab.originalPrice}</span>
              <span class="price-amount">{siteConfig.stores.macLab.price}</span>
            </div>
            <span class="price-term">one-time · 40% launch discount auto-applied</span>
          </div>
        </div>

        <ul class="feature-list">
          <li>Full access to all 39+ film stocks &amp; optical tools</li>
          <li>Unlimited custom film recipes &amp; QR Recipe Card sync</li>
          <li>Full-resolution RAW, JPEG, HEIC &amp; TIFF development</li>
          <li>Studio framing, borders &amp; EXIF metadata stamps</li>
          <li>License key valid for <strong>2 Macs</strong> simultaneously</li>
          <li>Free 1.x updates via built-in <em>Check for Updates…</em></li>
        </ul>

        <div class="pricing-actions">
          <a
            href={siteConfig.stores.macLab.checkoutUrl === '#buy' ? `mailto:${siteConfig.supportEmail}?subject=NeoFilm%20Lab%20for%20macOS%20License` : siteConfig.stores.macLab.checkoutUrl}
            class="btn-buy full-width"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Buy License Key — {siteConfig.stores.macLab.price} <s class="btn-strike">{siteConfig.stores.macLab.originalPrice}</s></span>
          </a>
          <p class="checkout-note">
            40% discount code <strong>NEOFILM40</strong> is automatically applied at checkout. Instant DMG download and license key delivered by email.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section faq-section" aria-labelledby="lab-faq-title">
    <div class="container faq-grid">
      <div class="section-heading">
        <span class="eyebrow">Questions &amp; Licensing</span>
        <h2 id="lab-faq-title">Everything you need to know.</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-hero {
    padding: clamp(64px, 9vw, 112px) 0 clamp(56px, 8vw, 96px);
    border-bottom: 1px solid var(--color-seam);
    background: radial-gradient(circle at 50% 18%, rgba(255, 85, 0, 0.12), transparent 58%);
  }
  .hero-header {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  .badge-row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .version-pill {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .hero-header h1 {
    margin-bottom: 20px;
    font-size: clamp(2.6rem, 6vw, 4.7rem);
  }
  .hero-header h1 em {
    color: var(--color-accent-hover);
    font-style: normal;
  }
  .hero-header .lead {
    max-width: 700px;
    margin: 0 auto 30px;
  }
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .btn-buy {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 24px;
    border-radius: 11px;
    background: var(--color-accent);
    color: #fff;
    font-weight: 760;
    font-size: 0.98rem;
    box-shadow: 0 14px 34px rgba(255, 85, 0, 0.28);
    transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }
  .btn-buy:hover {
    color: #fff;
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 18px 40px rgba(255, 85, 0, 0.36);
  }
  .price-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.26);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }
  .price-strike {
    text-decoration: line-through;
    opacity: 0.65;
    font-size: 0.82em;
  }
  .price-current {
    font-weight: 800;
    color: #fff;
  }
  .discount-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 85, 0, 0.16);
    border: 1px solid rgba(255, 85, 0, 0.35);
    color: var(--color-accent-hover);
    font-weight: 700;
  }
  .hero-meta {
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-family: var(--font-mono);
  }
  .hero-showcase {
    margin-top: clamp(40px, 6vw, 64px);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid rgba(255, 135, 65, 0.28);
    background: #09090b;
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.65);
  }
  .hero-showcase img {
    width: 100%;
    height: auto;
    display: block;
  }
  .showcase-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 14px 20px;
    border-top: 1px solid var(--color-seam);
    background: var(--color-surface-chassis);
    color: var(--color-text-secondary);
    font-size: 0.84rem;
  }
  .showcase-bar strong {
    color: #fff;
  }
  .showcase-bar .dot {
    color: var(--color-accent);
  }

  .feature-split {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
  }
  .feature-split.reverse {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .feature-copy h2 {
    margin: 12px 0 18px;
  }
  .feature-copy .lead {
    margin-bottom: 24px;
  }
  .feature-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.5);
  }
  kbd {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.82em;
  }
  .card-number {
    display: block;
    margin-bottom: 22px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .buy-section {
    background: radial-gradient(circle at 80% 50%, rgba(255, 85, 0, 0.09), transparent 60%), var(--color-surface-chassis);
    border-top: 1px solid var(--color-seam);
    border-bottom: 1px solid var(--color-seam);
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: clamp(36px, 7vw, 88px);
    align-items: center;
  }
  .pricing-copy h2 {
    margin: 12px 0 18px;
  }
  .ownership-highlights {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--color-seam);
  }
  .ownership-highlights strong {
    display: block;
    color: #fff;
    margin-bottom: 4px;
    font-size: 1rem;
  }
  .ownership-highlights p {
    font-size: 0.92rem;
  }
  .pricing-card {
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 85, 0, 0.42);
    background: linear-gradient(155deg, rgba(255, 85, 0, 0.1), transparent 55%), #111115;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.45);
  }
  .pricing-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-seam);
  }
  .plan-label {
    display: block;
    color: var(--color-accent-hover);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }
  .pricing-card-top h3 {
    font-size: 1.65rem;
  }
  .price-block {
    text-align: right;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 10px;
  }
  .price-strike-large {
    color: var(--color-text-muted);
    font-size: 1.5rem;
    text-decoration: line-through;
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .copy-strike {
    color: var(--color-text-muted);
    text-decoration: line-through;
    margin-right: 4px;
  }
  .btn-strike {
    text-decoration: line-through;
    opacity: 0.65;
    margin-left: 6px;
    font-weight: 500;
  }
  .price-amount {
    display: block;
    color: #fff;
    font-size: 2.5rem;
    font-weight: 820;
    line-height: 1;
  }
  .price-term {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .pricing-actions {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--color-seam);
  }
  .btn-buy.full-width {
    width: 100%;
  }
  .checkout-note {
    margin-top: 14px;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 70px;
  }
  .faq-list {
    border-top: 1px solid var(--color-seam);
  }
  details {
    border-bottom: 1px solid var(--color-seam);
  }
  summary {
    cursor: pointer;
    padding: 21px 34px 21px 0;
    color: white;
    font-weight: 700;
  }
  details p {
    padding: 0 0 22px;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .feature-split,
    .feature-split.reverse,
    .pricing-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .feature-split.reverse .feature-visual {
      order: 2;
    }
    .feature-split.reverse .feature-copy {
      order: 1;
    }
  }
</style>
