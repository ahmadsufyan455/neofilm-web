---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '../config/site';

export interface Props {
  title: string;
  documentTitle: string;
  description: string;
  canonicalPath: string;
  effectiveDate?: string;
  lastUpdated?: string;
}

const {
  title,
  documentTitle,
  description,
  canonicalPath,
  effectiveDate = siteConfig.legal.privacyEffectiveDate,
  lastUpdated = siteConfig.legal.lastUpdated,
} = Astro.props;

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: documentTitle, url: canonicalPath }];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} breadcrumbs={breadcrumbs}>
  <header class="page-hero legal-hero">
    <div class="container-narrow">
      <span class="eyebrow">Legal</span>
      <h1>{documentTitle}</h1>
      <p>Applies to the NeoFilm mobile applications and this website.</p>
      <dl>
        <div><dt>Effective</dt><dd>{effectiveDate}</dd></div>
        <div><dt>Updated</dt><dd>{lastUpdated}</dd></div>
        <div><dt>Operator</dt><dd>{siteConfig.publisher.developer}</dd></div>
      </dl>
    </div>
  </header>
  <div class="legal-wrap container-narrow">
    <article class="legal-content"><slot /></article>
    <aside>
      <h2>Questions?</h2>
      <p>Contact <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.</p>
    </aside>
  </div>
</BaseLayout>

<style>
  .legal-hero h1 { font-size: clamp(2.6rem, 6vw, 4.3rem); }
  dl { display: flex; flex-wrap: wrap; gap: 22px 40px; margin-top: 28px; }
  dl div { display: grid; gap: 2px; }
  dt { color: var(--color-text-muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  dd { color: var(--color-text-primary); font-size: .9rem; }
  .legal-wrap { padding: 64px 0 96px; }
  .legal-content { color: var(--color-text-secondary); }
  .legal-content :global(h2) { margin: 52px 0 14px; font-size: 1.55rem; }
  .legal-content :global(h2:first-child) { margin-top: 0; }
  .legal-content :global(h3) { margin: 28px 0 10px; font-size: 1.1rem; }
  .legal-content :global(p), .legal-content :global(ul) { margin-bottom: 17px; }
  .legal-content :global(ul) { padding-left: 22px; }
  .legal-content :global(li) { margin-bottom: 7px; }
  .legal-content :global(a), aside a { color: var(--color-accent-hover); text-decoration: underline; text-underline-offset: 3px; }
  .legal-content :global(strong) { color: var(--color-text-primary); }
  .legal-content :global(.callout-notice) { padding: 18px 20px; border-left: 3px solid var(--color-accent); background: var(--color-surface-chassis); }
  aside { margin-top: 56px; padding: 26px; border: 1px solid var(--color-seam); border-radius: var(--radius-lg); background: var(--color-surface-chassis); }
  aside h2 { margin-bottom: 8px; font-size: 1.25rem; }
</style>
